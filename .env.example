# Upvane configuration. Next.js reads .env.local; Edge Functions read supabase/functions/.env locally
# (`supabase functions serve --env-file`) and Supabase secrets in production (`supabase secrets set`).
# Never put real secrets in NEXT_PUBLIC_* variables or in migrations.

# ---------------------------------------------------------------- Next.js
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here
# Server only: workers, admin reads after an explicit check, plan changes.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Public URL of the app, without trailing slash (status pages, emails, feeds, API docs).
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Base64 of 32 random bytes (openssl rand -base64 32). Encrypts monitor secret headers, channel secrets and
# subscriber targets, and derives unsubscribe tokens. Must be the same in Next and in the Edge Functions.
UPVANE_SECRETS_KEY=replace-with-openssl-rand-base64-32
# Shared with the monitor-runner Edge Function: lets "Run now" in the dashboard and the API start a check.
MONITOR_RUNNER_SECRET=replace-with-a-long-random-secret
# demo: plan changes apply at once (no payments). Anything else answers 501 until billing is connected.
BILLING_MODE=demo
# Optional: hostname that serves the public API (api.example.com/v1 → /api/v1).
UPVANE_API_HOST=

# Email (Resend). Without a key, local runs deliver to Mailpit (LOCAL_MAILPIT_URL).
RESEND_API_KEY=re_your_resend_api_key
# A sender your Resend account allows; production uses a verified domain such as Upvane <alerts@upvane.com>.
ALERTS_EMAIL_FROM="Upvane <alerts@upvane.com>"
LOCAL_MAILPIT_URL=http://127.0.0.1:54324

# Custom status page domains (optional). Customers point a CNAME at CUSTOM_DOMAIN_CNAME_TARGET; with a Vercel token
# the domain is also added to the Vercel project so HTTPS is issued.
CUSTOM_DOMAIN_CNAME_TARGET=cname.upvane.dev
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=

# Local development only: /api/dev/login signs in seeded users for screenshots and tests. Never set in production.
UPVANE_DEV_LOGIN=

# ---------------------------------------------------------------- Edge Functions (Supabase secrets)
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are provided by Supabase.
# PUBLIC_APP_URL=https://app.upvane.com          # links in alerts and emails (NEXT_PUBLIC_APP_URL also works locally)
# UPVANE_SECRETS_KEY=…                            # same value as above
# ALERT_WORKER_SECRET=…                           # pg_net and cron wake the alert-worker with it
# MONITOR_RUNNER_SECRET=…                         # same value as above
# MONITOR_PROBE_SECRET=…                          # monitor-runner → monitor-probe in each region
# MONITOR_PROBE_REGIONS=eu-central-1,us-east-1    # optional allow-list of probe regions
# MONITOR_PROBE_URL=                              # optional override of the probe URL (local stacks)
# RESEND_API_KEY=… ALERTS_EMAIL_FROM=…            # as above
# LOCAL_MAILPIT_URL=http://host.docker.internal:54324
